DATABASE_URL=postgresql://re_ai:local_password@localhost:5432/re_ai
DATABASE_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
SEARCH_TOP_K=5
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_RRF_K=60
LAW_API_OC=test
LAW_API_BASE_URL=https://www.law.go.kr/DRF
LAW_API_TIMEOUT_SECONDS=30

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_NAMESPACE=re-ai-reference

# LegalGraphRAG implementation; separate from the waste/process graph.
LEGAL_GRAPH_NAMESPACE=re-ai-legal
LEGAL_GRAPH_MODEL_ENABLED=false
LEGAL_GRAPH_ALLOW_EXTERNAL=false
LEGAL_GRAPH_MODEL=solar-pro4
LEGAL_GRAPH_TIMEOUT_SECONDS=60
UPSTAGE_API_KEY=


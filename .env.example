DATABASE_URL=postgresql://re_ai:local_password@127.0.0.1:5432/re_ai
DATABASE_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
SEARCH_TOP_K=5
HYBRID_CANDIDATE_MULTIPLIER=4
HYBRID_RRF_K=60
# Optional local neural reranker: install .[embeddings,reranker] and run setup_reranker first.
# Defaults keep working without downloading weights. Selection evidence: docs/rag-hardening-2026-10-26.md
HYBRID_CANDIDATE_MINIMUM=0
RETRIEVAL_ARTICLE_DIVERSITY=false
# Exact legal reference companions are enabled for LEGAL / explicit legal corpus searches.
RETRIEVAL_LEGAL_BASIS=true
# Experimental: needs .[korean-lexical] and build_korean_legal_index.py; default remains off.
RETRIEVAL_KOREAN_LEXICAL=false
RERANKER_PROVIDER=rules
RERANKER_MODEL_DIRECTORY=
LAW_API_OC=test
LAW_API_BASE_URL=https://www.law.go.kr/DRF
LAW_API_TIMEOUT_SECONDS=30

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_NAMESPACE=re-ai-reference

# LegalGraphRAG implementation; separate from the waste/process graph.
LEGAL_GRAPH_NAMESPACE=re-ai-legal
LEGAL_GRAPH_MODEL_ENABLED=false
LEGAL_GRAPH_ALLOW_EXTERNAL=false
LEGAL_GRAPH_MODEL=solar-pro4
LEGAL_GRAPH_TIMEOUT_SECONDS=60
# Azure deployment name may differ from the catalog model name. Never auto-fallback.
LEGAL_GRAPH_MODEL_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# Only set after checking that this endpoint/deployment actually hosts Astra in Azure.
AZURE_OPENAI_DEPLOYMENT_MODEL=
AZURE_OPENAI_REASONING_EFFORT=high
AZURE_OPENAI_MAX_OUTPUT_TOKENS=16384
AZURE_OPENAI_API_KEY=
UPSTAGE_API_KEY=

# Optional GPT-6 Astra/high semantic Critic. Request semantic_critic={} as well.
# Separate from LEGAL_GRAPH_*; defaults make no model calls.
SEMANTIC_CRITIC_ENABLED=false
SEMANTIC_CRITIC_ALLOW_EXTERNAL=false
# Backend-to-engine header: X-Critic-Service-Token (never expose to the browser).
SEMANTIC_CRITIC_SERVICE_TOKEN=
SEMANTIC_CRITIC_TIMEOUT_SECONDS=120
SEMANTIC_CRITIC_MAX_INPUT_CHARS=120000
SEMANTIC_CRITIC_MAX_OUTPUT_TOKENS=8192

# Road API calls are disabled until keys, a backend service token and permission exist.
ROAD_ROUTING_ENABLED=false
ROAD_ROUTING_ALLOW_EXTERNAL=false
ROAD_ROUTING_PROVIDER=none
ROAD_ROUTING_TIMEOUT_SECONDS=5
ROAD_ROUTING_TOTAL_TIMEOUT_SECONDS=20
ROAD_ROUTING_MAX_CALLS=10
ROAD_ROUTING_SERVICE_TOKEN=
KAKAO_MOBILITY_REST_API_KEY=
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

